#include <iostream>
#include <string>
#include <map>


using namespace std;


class Solution {
public:

    bool isAnagram(string s, string t) {


        if (t.length() != s.length()) {
            return false;
        }

        map<char, int> mp;

        for (int i = 0; i < t.length(); i++) {
            mp[t[i]]++;
        }

        for (int i = 0; i < s.length(); i++) {
            auto it = mp.find(s[i]);

            if (it == mp.end() || it->second == 0 ) {
                return false;

            }

            it->second--;
        }

        return true;

    }
};

int main() {

    string s = "rat";
    string t = "car";


    Solution ans;


    ans.isAnagram(s, t);


    return 0;
}
